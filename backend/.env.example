# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Postgres). Set DB_DIALECT=mysql to use MySQL instead.
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shelfx
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# SMTP / Email service (works with Gmail app passwords, SendGrid, Mailtrap, SES SMTP, etc.)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="ShelfX Library" <no-reply@shelfx.app>

# Borrowing rules
LOAN_PERIOD_DAYS=10
LATE_FINE_FLAT=200

# Optional: Google Maps API key (only needed if you swap Leaflet for Google Maps)
GOOGLE_MAPS_API_KEY=
